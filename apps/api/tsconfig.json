{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "lib": ["ES2022"],
    "noEmit": true,
    "isolatedModules": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "types": ["node"]
  },
  // Tekshiruv uchun seed skripti ham qamrab olinadi.
  // Build esa `tsconfig.build.json` bilan ketadi — u faqat `src` ni oladi.
  "include": ["src/**/*", "prisma/**/*"],
  "exclude": ["dist", "node_modules"]
}
