{
  // Izoh uchun: packages/core/tsconfig.build.json ga qarang —
  // chiqish formati bir xil sababga ko'ra CommonJS.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "isolatedModules": false
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
