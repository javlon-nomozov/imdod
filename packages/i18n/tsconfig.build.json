{
  // Izoh uchun: packages/core/tsconfig.build.json ga qarang — nega
  // CJS+ESM ikkalasi kerakligi shu yerda tushuntirilgan.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": "src",
    "outDir": "dist/cjs",
    "noEmit": false,
    "isolatedModules": false
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
