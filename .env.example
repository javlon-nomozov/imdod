# --- Ma'lumotlar bazasi ---
# Diqqat: 5433 (5432 emas) — bu kompyuterda alohida PostgreSQL o'rnatilgan
# va u 5432 ni band qilgan. docker-compose.yml ham 5433 ga sozlangan.
DATABASE_URL="postgresql://imdod:imdod_dev_password@localhost:5433/imdod?schema=public"

# --- API ---
API_PORT=3000
NODE_ENV=development

# JWT sirlari (ishlab chiqarishda albatta o'zgartiring!)
JWT_ACCESS_SECRET="dev-only-access-secret-change-me"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# POS qurilma tokeni uchun sir
DEVICE_TOKEN_SECRET="dev-only-device-secret-change-me"

# --- Telegram bot (9-bosqich) ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_MINIAPP_URL="http://localhost:3001/miniapp"

# --- Web (8-bosqich) ---
NEXT_PUBLIC_API_URL="http://localhost:3000"
